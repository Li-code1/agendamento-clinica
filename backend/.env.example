# URL de conexão do PostgreSQL (Supabase). Veja o README para instruções de como obter.
DATABASE_URL=

# Porta em que a API vai rodar localmente
PORT=3333

# Timezone usado em todas as regras de data/hora do sistema
TIMEZONE=America/Sao_Paulo

# Origem permitida para CORS (URL do frontend)
FRONTEND_URL=http://localhost:5173
